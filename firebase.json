{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "README.md",
      "*.log",
      "*.code-workspace",
      "styles-backup.css",
      "styles-new.css",
      "Crear usario.Js",
      "server.js",
      "data/usuarios.json",
      "data/profesores.json",
      "fotos-galeria/**",
      "fotos-noticias/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
